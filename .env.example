# Plex MCP Server Configuration

# Plex Server URL
# Replace localhost with your server's IP address if running remotely
# Default port is usually 32400
PLEX_URL=http://localhost:32400

# Plex Authentication Token
# See instructions in README.md or https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=your_plex_token_here

# Optional: Enable mutative/write Plex tools
# Disabled by default for safety. Set to true to enable.
# PLEX_ENABLE_MUTATIVE_OPS=true

# Optional: Emit tool responses as TOON instead of JSON
# TOON is a compact, LLM-oriented encoding of the same data — noticeably fewer
# tokens on list-shaped responses. Responses fall back to JSON whenever TOON
# would not be shorter, so this can never make a response larger.
# PLEX_OUTPUT_FORMAT=toon

# Optional: Specify custom port for the MCP server (if needed)
# MCP_PORT=3000

# Optional: URL path the HTTP transport serves MCP on (default: /mcp)
# MCP_PATH=/mcp

# Optional: Bytes one HTTP session's library exports may take together
# (default: 262144, which is 256 KiB). The oldest are removed to make room.
# An item takes roughly 130 bytes (movie, track), 180 (show) or 270 (episode),
# so the default holds about 2,000 movies or 950 episodes.
# PLEX_EXPORT_MAX_BYTES=262144

# Optional: Seconds before an HTTP library export expires (default: 604800,
# which is 7 days). An expired export is no longer served, and its file is
# deleted within the hour, including exports left behind by a killed server.
# PLEX_EXPORT_MAX_AGE_SECONDS=604800

# Optional: Seconds export_library waits for one page from Plex before it gives
# up (default: 60). Raise it if a large library's pages time out.
# PLEX_EXPORT_TIMEOUT_SECONDS=60

# Optional: Enable debug logging
# DEBUG=true

# ──── Sonarr Configuration (for plex-arr-server) ────
# Sonarr URL (default: http://localhost:8989)
# SONARR_URL=http://localhost:8989

# Sonarr API Key
# Find at: Sonarr → Settings → General → API Key
# SONARR_API_KEY=your_sonarr_api_key_here

# ──── Radarr Configuration (for plex-arr-server) ────
# Radarr URL (default: http://localhost:7878)
# RADARR_URL=http://localhost:7878

# Radarr API Key
# Find at: Radarr → Settings → General → API Key
# RADARR_API_KEY=your_radarr_api_key_here
